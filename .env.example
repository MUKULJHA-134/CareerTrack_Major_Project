# CareerTrack Master Environment Configuration Guide
#
# Backend Configuration (Place in backend/.env):
# PORT=5000
# NODE_ENV=development
# MONGODB_URI=mongodb://127.0.0.1:27017/careertrack (or your MongoDB Atlas connection string)
# JWT_SECRET=Wright_your_super_secret_jwt_key
# JWT_EXPIRES_IN=7d
# MAX_FILE_SIZE=5242880
# UPLOAD_DIR=uploads/resumes
# CLIENT_URL=http://localhost:5173
#
# Frontend Configuration (Place in frontend/.env):
# VITE_API_URL= (leave empty for local dev proxy, or provide backend URL in production)
