# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB Atlas URI or local MongoDB connection string:
# e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/careertrack?retryWrites=true&w=majority
# If left blank or connection to localhost fails, the server will seamlessly launch an in-memory MongoDB instance for development & evaluation!
MONGODB_URI=mongodb://127.0.0.1:27017/careertrack

# JWT Secret for Administrator Authentication
JWT_SECRET=super_secret_jwt_key_careertrack_2026_recruitment_auth
